# zhycms Docker 环境变量
# 拷贝为 .env 并修改：cp docker/.env.example .env

# 应用密钥（必改，建议随机 32+ 字符）
SECRET_KEY=changeme-to-random-secret

# 数据库连接（MySQL 示例）
DB_URI=mysql+pymysql://zhycms:zhycms@db:3306/zhycms?charset=utf8mb4

# PostgreSQL 示例（取消注释并配合 --profile postgres）
# DB_URI=postgresql+psycopg2://zhycms:zhycms@postgres:5432/zhycms

# MySQL 密码
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=zhycms

# PostgreSQL 密码
POSTGRES_PASSWORD=zhycms

# Gunicorn worker 数量
GUNICORN_WORKERS=4

# Meilisearch（可选，配合 --profile search）
MEILI_MASTER_KEY=

# ============================================================
# 国内镜像源加速（可选）
# 构建/部署涉及三层下载，国内网络建议逐层配置：
#
# 【第 1 层】基础镜像拉取（由 Docker 守护进程完成，.env 无法控制）
#   涉及镜像：python:3.12-slim（构建）、mysql:8.4 / postgres:16-alpine（数据库）、
#             getmeili/meilisearch:v1.8（可选搜索 profile）。
#   若 docker pull 超时/报错，二选一：
#
#   方式 A（推荐，全局生效）：配置 Docker 守护进程镜像加速，
#     编辑 /etc/docker/daemon.json：
#       {
#         "registry-mirrors": [
#           "https://docker.m.daocloud.io",
#           "https://docker.1ms.run"
#         ]
#       }
#     然后 sudo systemctl restart docker，再正常 docker compose up。
#
#   方式 B（单镜像手动拉取后 retag，不改守护进程配置）：
#       docker pull docker.m.daocloud.io/library/python:3.12-slim
#       docker tag  docker.m.daocloud.io/library/python:3.12-slim python:3.12-slim
#       docker pull docker.m.daocloud.io/library/mysql:8.4
#       docker tag  docker.m.daocloud.io/library/mysql:8.4 mysql:8.4
#       # postgres profile 用：
#       docker pull docker.m.daocloud.io/library/postgres:16-alpine
#       docker tag  docker.m.daocloud.io/library/postgres:16-alpine postgres:16-alpine
#       # search profile 用（非 library 官方镜像，路径不带 library/）：
#       docker pull docker.m.daocloud.io/getmeili/meilisearch:v1.8
#       docker tag  docker.m.daocloud.io/getmeili/meilisearch:v1.8 getmeili/meilisearch:v1.8
#
# 【第 2 层】镜像构建时的 apt 系统包（Debian 源）
# 【第 3 层】镜像构建时的 pip Python 包（PyPI 源）
#   下面两个变量在 docker compose build 时作为 --build-arg 传入 Dockerfile。
#   本模板默认启用清华源（国内开箱即用）；海外构建请把这两行注释掉或留空，
#   compose 的默认值即官方源（deb.debian.org / pypi.org）。
#   注意：构建参数在 build 时固化，修改后需重新构建：
#       docker compose build      或   docker compose up --build
# ============================================================
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 其他可选源（按需替换上两行）：
#   pip：阿里云 https://mirrors.aliyun.com/pypi/simple/
#   apt：阿里云 mirrors.aliyun.com
#
# 手动 docker build 时的等价命令：
#   docker build \
#     --build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn \
#     --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
#     -t zhycms .
