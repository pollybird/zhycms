# zhycms Docker 环境变量
# 拷贝为 .env 并修改：cp docker/.env.example .env
#
# 镜像来源：官方镜像已发布到 Docker Hub（pollybird/zhycms），开箱即用：
#   docker compose -f docker-compose.mysql.yml up -d       # MySQL，自动拉取 pollybird/zhycms:mysql
#   docker compose -f docker-compose.postgresql.yml up -d  # PostgreSQL，自动拉取 pollybird/zhycms:postgresql
# 三个 tag（mysql/postgresql/latest）指向同一镜像，内置 MySQL + PostgreSQL 驱动。
# 如需本地构建，使用通用编排文件 docker-compose.yml（--profile mysql/mariadb/postgres/sqlite）。
#
# 信创底座：
#   docker compose -f docker-compose.opengauss.yml up -d --build   # openGauss 7.0
#   缓存后端可追加 --profile openamdc（REDIS_URL=redis://openamdc:6379/0），
#   或继续使用 --profile redis。
#   openGauss 应用镜像标签为 pollybird/zhycms:opengauss（内置官方驱动）。
#   docker compose -f docker-compose.kingbase.yml up -d             # 人大金仓 KingbaseES（pg 模式，镜像与授权需自行从官方获取）

# 应用密钥（必改，建议随机 32+ 字符）
SECRET_KEY=changeme-to-random-secret

# 数据库连接（MySQL 示例）
DB_URI=mysql+pymysql://zhycms:zhycms@db:3306/zhycms?charset=utf8mb4

# MariaDB 示例（与 MySQL 同一驱动，取消注释并配合 --profile mariadb）
# DB_URI=mysql+pymysql://zhycms:zhycms@db-mariadb:3306/zhycms?charset=utf8mb4

# PostgreSQL 示例（取消注释并配合 --profile postgres）
# DB_URI=postgresql+psycopg2://zhycms:zhycms@postgres:5432/zhycms

# openGauss 示例（使用 docker-compose.opengauss.yml 时由编排文件注入，无需在此配置）
# DB_URI=opengauss+psycopg2://gaussdb:Zhycms-2026og@db-opengauss:5432/zhycms

# KingbaseES 示例（使用 docker-compose.kingbase.yml 时由编排文件注入，无需在此配置；
# 镜像与授权需自行从官方获取 https://www.kingbase.com.cn/download.html）
# DB_URI=kingbase+psycopg2://system:你的密码@db-kingbase:54321/zhycms

# SQLite 示例（配合 --profile sqlite，无需外部数据库）
# DB_URI=sqlite:////app/instance/zhycms.db

# MySQL 密码
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=zhycms

# MariaDB 密码（--profile mariadb 时使用）
MARIADB_ROOT_PASSWORD=root
MARIADB_PASSWORD=zhycms

# PostgreSQL 密码
POSTGRES_PASSWORD=zhycms

# openGauss（docker-compose.opengauss.yml）
# 密码必须包含大写、小写、数字与特殊字符；此处用 - 作为特殊字符以保证 URI 安全。
OPENGAUSS_PASSWORD=Zhycms-2026og
# 官方镜像缺少 libopenblas.so.0，默认通过 docker/opengauss/Dockerfile 派生修复。
OPENGAUSS_BASE_IMAGE=opengauss/opengauss:7.0.0-RC3.B025-openEuler22.03
OPENGAUSS_IMAGE=pollybird/opengauss:7.0.0

# KingbaseES 人大金仓（docker-compose.kingbase.yml；仅 pg 模式，默认端口 54321 / 账号 system）
# 镜像与授权文件需自行从官方获取：https://www.kingbase.com.cn/download.html
# 生产务必修改密码（不填则 compose 回退默认弱口令 Kingbase123）。
KINGBASE_PASSWORD=changeme
# 自行 docker load 的 KingbaseES 镜像名（默认值见 compose 文件，如不同请取消注释并覆盖）
# KINGBASE_IMAGE=kingbase_v009r001c010b0004_single_x86:v1

# Web 端口（compose 映射到容器 5000）
WEB_PORT=5000

# Gunicorn worker 数量
GUNICORN_WORKERS=4

# Meilisearch（可选，配合 --profile search）
MEILI_MASTER_KEY=

# Redis（可选，配合 --profile redis）
# 留空则使用 SimpleCache + Cookie Session（单机部署零依赖）
# 启用后缓存与 Session 走 Redis，支持多实例负载均衡
REDIS_URL=

# openAMDC（信创缓存后端，配合 --profile openamdc）
# 启用时把 REDIS_URL 设为 redis://openamdc:6379/0（不要同时启用 redis profile）。
# 镜像未发布时可本地构建：docker build -t pollybird/openamdc:1.0.0 docker/openamdc
OPENAMDC_IMAGE=pollybird/openamdc:1.0.0

# ============================================================
# 国内镜像源加速（可选）
# 构建/部署涉及三层下载，国内网络建议逐层配置：
#
# 【第 1 层】基础镜像拉取（由 Docker 守护进程完成，.env 无法控制）
#   涉及镜像：python:3.12-slim（构建）、mysql:8.4 / mariadb:11.4 / postgres:16-alpine（数据库）、
#             opengauss/opengauss:7.0.0-RC3.B025-openEuler22.03（openGauss 数据库）、
#             getmeili/meilisearch:v1.8（可选搜索 profile）、redis:8-alpine（可选 redis profile）、
#             openeuler/openeuler:24.03-lts-sp1（openAMDC 构建基座）。
#   若 docker pull 超时/报错，二选一：
#
#   方式 A（推荐，全局生效）：配置 Docker 守护进程镜像加速，
#     编辑 /etc/docker/daemon.json：
#       {
#         "registry-mirrors": [
#           "https://docker.m.daocloud.io",
#           "https://docker.1ms.run"
#         ]
#       }
#     然后 sudo systemctl restart docker，再正常 docker compose up。
#
#   方式 B（单镜像手动拉取后 retag，不改守护进程配置）：
#       docker pull docker.m.daocloud.io/library/python:3.12-slim
#       docker tag  docker.m.daocloud.io/library/python:3.12-slim python:3.12-slim
#       docker pull docker.m.daocloud.io/library/mysql:8.4
#       docker tag  docker.m.daocloud.io/library/mysql:8.4 mysql:8.4
#       # postgres profile 用：
#       docker pull docker.m.daocloud.io/library/postgres:16-alpine
#       docker tag  docker.m.daocloud.io/library/postgres:16-alpine postgres:16-alpine
#       # search profile 用（非 library 官方镜像，路径不带 library/）：
#       docker pull docker.m.daocloud.io/getmeili/meilisearch:v1.8
#       docker tag  docker.m.daocloud.io/getmeili/meilisearch:v1.8 getmeili/meilisearch:v1.8
#       # openGauss 用：
#       docker pull docker.m.daocloud.io/opengauss/opengauss:7.0.0-RC3.B025-openEuler22.03
#       docker tag  docker.m.daocloud.io/opengauss/opengauss:7.0.0-RC3.B025-openEuler22.03 \
#                   opengauss/opengauss:7.0.0-RC3.B025-openEuler22.03
#       # openAMDC 构建基座：
#       docker pull docker.m.daocloud.io/openeuler/openeuler:24.03-lts-sp1
#       docker tag  docker.m.daocloud.io/openeuler/openeuler:24.03-lts-sp1 openeuler/openeuler:24.03-lts-sp1
#
# 【第 2 层】镜像构建时的 apt 系统包（Debian 源）
# 【第 3 层】镜像构建时的 pip Python 包（PyPI 源）
#   下面两个变量在 docker compose build 时作为 --build-arg 传入 Dockerfile。
#   本模板默认启用清华源（国内开箱即用）；海外构建请把这两行注释掉或留空，
#   compose 的默认值即官方源（deb.debian.org / pypi.org）。
#   注意：构建参数在 build 时固化，修改后需重新构建：
#       docker compose build      或   docker compose up --build
# ============================================================
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 其他可选源（按需替换上两行）：
#   pip：阿里云 https://mirrors.aliyun.com/pypi/simple/
#   apt：阿里云 mirrors.aliyun.com
#
# 手动 docker build 时的等价命令：
#   docker build \
#     --build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn \
#     --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
#     -t zhycms .
